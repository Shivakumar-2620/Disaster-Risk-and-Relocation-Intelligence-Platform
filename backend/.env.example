DATABASE_URL=sqlite:///./wayanad.db
APP_TITLE=Wayanad Disaster Risk & Relocation Intelligence API
DEBUG=true

# ── Live / near-real-time monitoring ──────────────────────────────
# Source for live weather: "imd" (live IMD API) or "demo" (simulated, default).
WEATHER_PROVIDER=demo
# Official IMD API credentials — ONLY via environment, never committed.
IMD_API_KEY=
IMD_API_BASE_URL=
# Auto-refresh interval (seconds) for the live map polling loop.
LIVE_REFRESH_INTERVAL_SECONDS=300
# A feed is considered stale after this many minutes.
LIVE_STALE_AFTER_MINUTES=15
LIVE_FALLBACK_TO_DEMO=true