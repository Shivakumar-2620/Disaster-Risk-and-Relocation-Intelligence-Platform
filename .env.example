# ── Real-time data API keys (frontend / Vite env) ───────────────────────────
# Copy this file to `.env` and fill in your keys. `.env` is gitignored — never
# commit real keys. The app falls back to DEMO / OSM tiles when a key is absent.
#
# Weather: WeatherAPI.com (https://www.weatherapi.com) — live Wayanad weather.
VITE_WEATHERAPI_KEY=

# Map tiles: Geoapify (https://www.geoapify.com) — vector basemap tiles.
VITE_GEOAPIFY_KEY=

# Optional: FastAPI backend base URL (only if you run the backend locally).
VITE_API_BASE=

# Live-map polling / staleness tuning.
VITE_LIVE_REFRESH_SECONDS=60
VITE_LIVE_STALE_MINUTES=15